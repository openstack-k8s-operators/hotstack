# cephadm-ansible v5.0.0 modules' primary import only works in a git
# checkout, not from an installed collection. Upstream fix (open):
# https://github.com/ceph/cephadm-ansible/pull/359 - trimmed to the
# modules present in v5.0.0 (the ceph_config_key.py hunk is dropped:
# that module does not exist in v5.0.0). Drop the patch entirely once
# the fix lands in a release.
diff --git a/plugins/modules/ceph_config.py b/plugins/modules/ceph_config.py
index d7a52b7..aed0963 100644
--- a/plugins/modules/ceph_config.py
+++ b/plugins/modules/ceph_config.py
@@ -8,7 +8,7 @@

 from ansible.module_utils.basic import AnsibleModule  # type: ignore
 try:
-    from ansible.module_utils.ceph_common import exit_module, build_base_cmd_shell, fatal  # type: ignore
+    from ansible_collections.ceph.cephadm.plugins.module_utils.ceph_common import exit_module, build_base_cmd_shell, fatal  # type: ignore
 except ImportError:
     from module_utils.ceph_common import exit_module, build_base_cmd_shell, fatal  # type: ignore

