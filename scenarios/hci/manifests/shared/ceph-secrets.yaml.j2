---
# Ceph integration secrets, rendered from bootstrap_vars.yml.
#
# ceph-conf-files: the cluster identity (fsid, client_key) for the
# ceph data plane service, plus the ceph.conf and the key-only
# client.openstack keyring for the control plane (extraMounts).
#
# cinder-ceph-config: the cinder RBD backend config, consumed via
# cinderVolumes.ceph.customServiceConfigSecrets (keeps the control
# plane manifest free of cluster-specific values).
apiVersion: v1
kind: Secret
metadata:
  name: ceph-conf-files
  namespace: openstack
type: Opaque
stringData:
  fsid: "{{ custom_ceph_fsid }}"
  client_key: "{{ custom_ceph_client_key }}"
  ceph.conf: |
    [global]
    fsid = {{ custom_ceph_fsid }}
    mon_host = {{ custom_ceph_mon_ips | join(',') }}
  ceph.client.openstack.keyring: |
    [client.openstack]
    	key = {{ custom_ceph_client_key }}
---
apiVersion: v1
kind: Secret
metadata:
  name: cinder-ceph-config
  namespace: openstack
type: Opaque
stringData:
  ceph-backend.conf: |
    [DEFAULT]
    enabled_backends = ceph
    [ceph]
    volume_backend_name = ceph
    volume_driver = cinder.volume.drivers.rbd.RBDDriver
    rbd_ceph_conf = /etc/ceph/ceph.conf
    rbd_user = openstack
    rbd_pool = volumes
    rbd_flatten_volume_from_snapshot = False
    rbd_secret_uuid = {{ custom_ceph_fsid }}
